{
  "manifest_version": 3,
  "name": "Cookie Cleaner",
  "description": "Cookie cleaner",
  "version": "2.0",
  "permissions": [
    "tabs",
    "storage",
    "unlimitedStorage"
  ],
  "content_scripts": [
    {
      "js": ["scripts/content.js"],
      "run_at": "document_end",
      "matches": [
        "https://auktion.hansemerkur.de/*",
        "https://outlook.office.com/mail/*",
        "https://outlook.office.com.mcas.ms/mail/*"
      ]
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "index.html",
    "default_icon": "icon.png"
  }
}