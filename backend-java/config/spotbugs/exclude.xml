<?xml version="1.0" encoding="UTF-8"?>
<FindBugsFilter>

    <!-- Exclude generated sources -->
    <Match>
        <Class name="~.*\.[\w]+\$[\w]+"/>
    </Match>

    <!-- Exclude test classes -->
    <Match>
        <Class name="~.*Test.*"/>
    </Match>

    <!-- Exclude Spring Boot application class from certain checks -->
    <Match>
        <Class name="com.trc.platform.TrcPlatformApplication"/>
        <Bug pattern="EI_EXPOSE_REP,EI_EXPOSE_REP2"/>
    </Match>

    <!-- Exclude Lombok generated code -->
    <Match>
        <Class name="~.*\$_*"/>
        <Bug pattern="SE_BAD_FIELD"/>
    </Match>

</FindBugsFilter>